    "subject_id": {
      "enum": [
        "02010002",
        "02010005",
        "02010006",
        "02010008",
        "02010010",
        "02010011",
        "02010012",
        "02010013",
        "02010015",
        "02010018",
        "02010022",
        "02010023",
        "02010024",
        "02010025",
        "02010034",
        "02010036",
        "02020008",
        "02020010",
        "02020014",
        "02020015",
        "02020016",
        "02020018",
        "02020019",
        "02020021",
        "02020022",
        "02020023",
        "02020025",
        "02020026",
        "02020027",
        "02030002",
        "02030004",
        "02030005",
        "02030006",
        "02030007",
        "02030009",
