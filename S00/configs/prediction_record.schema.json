    "inner_fold": {
      "type": [
        "integer",
        "null"
      ]
    },
    "split": {
      "enum": [
        "train",
        "val",
        "test"
      ]
    },
    "label": {
      "enum": [
        0,
        1
      ]
    },
    "p_eeg": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "p_speech": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "p_text": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "p_final": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "prediction": {
      "enum": [
        0,
        1
      ]
    },
    "fusion_weights": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 3
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cohort_id": {
      "const": "MODMA-37-v1"
    },
    "folds_sha256": {
      "const": "a28ebe92c94428128313586d3a5524b2f03befcbc473215f4b0b2dcb49c3284d"
