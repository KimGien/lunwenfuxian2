{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MODMA-37 subject prediction shared by baseline and subsequent experiments",
  "type": "object",
  "required": [
    "experiment",
    "subject_id",
    "seed",
    "outer_fold",
    "inner_fold",
    "split",
    "label",
    "p_eeg",
    "p_speech",
    "p_text",
    "p_final",
    "prediction",
    "fusion_weights",
    "source_manifest_sha256",
    "cohort_id",
    "folds_sha256"
