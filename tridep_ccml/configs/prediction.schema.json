{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TC MODMA-37 frozen-parent prediction record",
  "description": "Structure only. records.validate_prediction_records must also validate provenance, split membership, physical hashes and evidence arithmetic.",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment", "cohort_id", "cohort_sha256", "folds_sha256", "subject_id", "seed", "outer_fold", "split", "label", "train_ids", "parent_checkpoints", "source_features", "feature_manifest_sha256", "feature_npz_sha256", "training_config_sha256", "checkpoint_sha256", "initialization_sha256", "fusion_method", "fusion_weights", "views", "m", "e_con", "e_cmp", "e_final", "p_final", "u_final", "prediction", "rho", "delta", "gamma"],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableHash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "evidence": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0}},
    "probability": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "nullableEvidence": {"anyOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]},
    "u": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "descriptor": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "sourceViews": {"type": "object", "additionalProperties": false, "required": ["eeg", "speech", "text"], "properties": {"eeg": {"$ref": "#/$defs/descriptor"}, "speech": {"$ref": "#/$defs/descriptor"}, "text": {"$ref": "#/$defs/descriptor"}}},
    "view": {"type": "object", "additionalProperties": false, "required": ["e", "alpha", "p", "u"], "properties": {"e": {"$ref": "#/$defs/nullableEvidence"}, "alpha": {"anyOf": [{"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 1}}, {"type": "null"}]}, "p": {"$ref": "#/$defs/probability"}, "u": {"$ref": "#/$defs/u"}}}
  },
  "properties": {
    "experiment": {"enum": ["TC-00-weighted-37-fulltext", "TC-00-mean-37-fulltext", "TC-01-37-fulltext", "TC-02-37-fulltext", "TC-03-mean-37-fulltext", "TC-03-sum-37-fulltext", "TC-03-ccml-37-fulltext", "TC-04-37-fulltext", "TC-05a-37-fulltext", "TC-05b-37-fulltext", "TC-05c-37-fulltext"]},
    "cohort_id": {"const": "MODMA-37-v1"},
    "cohort_sha256": {"$ref": "#/$defs/hash"},
    "folds_sha256": {"const": "a28ebe92c94428128313586d3a5524b2f03befcbc473215f4b0b2dcb49c3284d"},
    "subject_id": {"type": "string", "pattern": "^[0-9]{8}$"},
    "seed": {"enum": [11, 22, 33]},
    "outer_fold": {"type": "integer", "minimum": 1, "maximum": 5},
    "split": {"enum": ["train", "val", "test"]},
    "label": {"enum": [0, 1]},
    "train_ids": {"type": "array", "uniqueItems": true, "minItems": 26, "maxItems": 27, "items": {"type": "string", "pattern": "^[0-9]{8}$"}},
    "parent_checkpoints": {"$ref": "#/$defs/sourceViews"},
    "source_features": {"$ref": "#/$defs/sourceViews"},
    "feature_manifest_sha256": {"$ref": "#/$defs/nullableHash"},
    "feature_npz_sha256": {"$ref": "#/$defs/nullableHash"},
    "training_config_sha256": {"$ref": "#/$defs/hash"},
    "checkpoint_sha256": {"$ref": "#/$defs/nullableHash"},
    "initialization_sha256": {"$ref": "#/$defs/nullableHash"},
    "fusion_method": {"enum": ["weighted_probability", "mean_probability", "mean_evidence", "sum_evidence", "ccml"]},
    "fusion_weights": {"anyOf": [{"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}}, {"type": "null"}]},
    "views": {"type": "object", "additionalProperties": false, "required": ["eeg", "speech", "text"], "properties": {"eeg": {"$ref": "#/$defs/view"}, "speech": {"$ref": "#/$defs/view"}, "text": {"$ref": "#/$defs/view"}}},
    "m": {"$ref": "#/$defs/nullableEvidence"},
    "e_con": {"$ref": "#/$defs/nullableEvidence"},
    "e_cmp": {"$ref": "#/$defs/nullableEvidence"},
    "e_final": {"$ref": "#/$defs/nullableEvidence"},
    "p_final": {"$ref": "#/$defs/probability"},
    "u_final": {"$ref": "#/$defs/u"},
    "prediction": {"enum": [0, 1]},
    "rho": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "delta": {"type": ["number", "null"], "minimum": 0},
    "gamma": {"type": ["number", "null"], "minimum": 0}
  }
}
